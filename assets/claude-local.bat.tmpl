@echo off
chcp 65001 >nul
rem Save this file with CRLF line endings; cmd.exe misparses LF-only batch files.
rem --settings overrides the env block in the user's settings.json for this invocation only.
rem Shell set commands lose to settings.json, so do not rely on them for local routing.
claude --settings "{{SETTINGS_PATH}}" --model {{CLAUDE_MODEL_ID}} %*
