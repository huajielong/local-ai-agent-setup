# NOTE: shell environment variables do NOT override the "env" block in
# ~/.claude/settings.json. If that file already defines ANTHROPIC_BASE_URL or
# model IDs, use claude-local.settings.json.tmpl with:
#   claude --settings <file> --model <id>
ANTHROPIC_BASE_URL=http://127.0.0.1:{{PROXY_PORT}}
ANTHROPIC_API_KEY={{DUMMY_KEY}}
ANTHROPIC_AUTH_TOKEN={{DUMMY_KEY}}
CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1
CLAUDE_MODEL_ID={{CLAUDE_MODEL_ID}}
